# Banco de dados -------------------------------------------------------------
# SQLite (padrao para desenvolvimento local)
DATABASE_URL="file:./dev.db"
# PostgreSQL (producao) - troque o provider em prisma/schema.prisma para "postgresql"
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/tunicotcg_control?schema=public"

# Seguranca ------------------------------------------------------------------
# Chave usada para assinar os cookies de sessao (JWT). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria-de-no-minimo-32-caracteres"

# Sessao expira em X dias
SESSION_DAYS="7"

# Dados do primeiro acesso (usados apenas pelo seed) --------------------------
SEED_ADMIN_EMAIL="admin@tunicotcg.com.br"
SEED_ADMIN_PASSWORD="Tunico@2025"
